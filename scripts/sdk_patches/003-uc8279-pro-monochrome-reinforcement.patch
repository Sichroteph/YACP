+bool Uc8279X4Driver::displayMonochromeReinforcement(EpdBus& bus, const uint8_t* fb, bool turnOff) {
+  if (!fb ||
+      (BoardConfig::ACTIVE.board != BoardConfig::Board::XteinkX4Pro &&
+       BoardConfig::ACTIVE.board != BoardConfig::Board::XteinkX4) ||
+      BoardConfig::ACTIVE.displayController != BoardConfig::DisplayController::UC8279 ||
+      BoardConfig::ACTIVE.displayControllerVariant != 0x68)
+    return false;
+  if (!_oldPlaneValid || _needFullClear || _redriveAfterGray || _directGrayOnPanel || _absoluteGrayPlanes) {
+    return false;
+  }
+  bus.waitBusy(" 8279_magic_ready");
+  // PON can reload MTP registers. Settle-table configuration must follow it.
+  powerOnIfNeeded(bus, " 8279_magic_PON");
+  streamPlane(bus, CMD_DTM2, fb);
+  runGrayscalePrecondition(bus, true);
+  streamPlane(bus, CMD_DTM1, fb);
+  _grayBaseValid = false;
+  _absoluteInput = false;
+  _absoluteGrayPlanes = false;
+  _oldPlaneValid = true;
+  _needFullClear = false;
+  if (turnOff && _isScreenOn) {
+    bus.cmd(CMD_POWER_OFF);
+    bus.waitBusy(" 8279_magic_POF");
+    _isScreenOn = false;
+  }
+  return true;
+}
