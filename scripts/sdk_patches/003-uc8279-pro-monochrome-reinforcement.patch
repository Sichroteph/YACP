+bool FreeInkDisplay::displayMonochromeReinforcement(bool turnOffScreen) {
+  cancelGrayscalePass();
+  if (!_driver) return false;
+  if (!_inverted && !_inversionDirty) {
+    DisplayPmLock pmLock;
+    syncPendingAsync();
+    if (_driver->displayMonochromeReinforcement(_bus, frameBuffer, turnOffScreen)) {
+      _grayPassFailed = false;
+      _shadowValid = false;
+      _redRamSynced = true;
+      return true;
+    }
+  }
+  displayBuffer(FULL_REFRESH, turnOffScreen);
+  return false;
 }
 
